/- kdl-version 2
// KDL v2 sample: needs the v2.0.0 grammar (libtree-sitter 0.25 or later).

/* A multi-line
   comment */
title "Hello, World"

// Node with arguments, properties, and type annotations
package (pkg)"kdl-mode" version="2.0.0" {
    authors "Alice" "Bob"
    license "MIT"
    enabled #true
    deprecated #false
    homepage #null
    (url)repository "https://example.com/kdl-mode"
}

// Special numbers and keywords
specials #inf #-inf #nan

// Numbers
numbers 1 -2 3.14 1.5e10 0xdeadbeef 0o755 0b1010 1_000_000

// Strings, escapes, and raw strings
strings "plain" "tab\there" "quote \" inside" "unicode \u{1F600}"
raw #"C:\path\no\escapes"# ##"has "# inside"##

// Bare identifier strings
bare-words hello world key=value

// Multi-line strings
multi """
    first line
      indented line
    last line
    """

// Slashdash comments
/-disabled-node "ignored" {
    child 1
}
node /-skipped-arg "kept" /-skipped=1 kept=2
parent {
    /-hidden { nested 1 }
    visible 1
}

// Nested children and indentation
server {
    listen "0.0.0.0" port=8080
    tls {
        cert "/etc/ssl/cert.pem"
        key "/etc/ssl/key.pem"
    }
}

// Semicolon separated nodes
a 1; b 2; c 3

// Line continuation
long-node 1 \
    2 \
    3
